# ---------------------------------------------------------------------------
# Bhumi Forensics - backend environment
# Copy to backend/.env and fill in. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# development | staging | production
ENVIRONMENT=development

# REQUIRED in staging/production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# In development, leaving this blank generates a machine-local key in
# backend/.dev_secret (gitignored).
SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=480

# Comma separated. '*' is rejected in production because the API sends credentials.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite for local development; PostgreSQL/PostGIS in Docker and production.
# DATABASE_URL=postgresql://postgres:CHANGE_ME@db:5432/bhoomi_land_records

# Uploads
MAX_UPLOAD_MB=25

# OCR. Only language packs actually installed are ever requested.
OCR_ENGINE=tesseract
OCR_LANGUAGES=en,hi,ta,te,kn
OCR_TWO_PASS=true
OCR_MIN_CHARS=20

# Confidence banding
CONFIDENCE_HIGH_THRESHOLD=0.90
CONFIDENCE_MEDIUM_THRESHOLD=0.70

# Seeding. Reference data (geography, mock master registry, users) is always
# seeded. This flag controls synthetic GIS demo parcels only. No documents are
# ever seeded: they enter through upload and real processing.
ENABLE_DEMO_SEED=true
# Required to seed accounts outside development.
SEED_DEFAULT_PASSWORD=

TRANSLATION_ENABLED=true
